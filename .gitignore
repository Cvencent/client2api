# 账号凭据、池状态、用量汇总、模型缓存。data/ 里就是活的 access_token/refresh_token，
# 绝不能进版本库；data-lab/ 是本地实验用的同一类数据。
data/
data-lab/
configs/client2api.json
*.key
*.pem
.env
.env.*

# 二进制产物。根目录下的 .exe 有 18MB；`~` 后缀是换二进制时的临时副本。
/client2api
/client2api.exe
/client2api.exe~
/client2api-verify.exe
*.exe
*.exe~

# 例外：随安装包分发的 Opus-only ffmpeg 是交付物的一部分，必须进版本库，
# 否则别人 clone 下来打不出带语音转写的安装包。它的 SHA256 钉在
# third_party/ffmpeg/ffmpeg.sha256：installer/build.ps1 打包前校验，
# clients/doubaoime 的测试也会断言。
!/third_party/ffmpeg/ffmpeg.exe

# 运行期日志与临时探针产物（_gw.log / _run.out / _k.json 这类调试落盘）。
# logs/ 单独列出来是因为它装的是真实聊天 payload（logs/*.json 里有探针发过的
# 请求体），而 *.log 只挡住后缀为 .log 的文件，挡不住这些。
*.log
*.tmp
run/
logs/
_*
*.zip
*.tar.gz

# Makefile 的构建产物目录。*.exe 在 Windows 上盖住了它，但 Linux/macOS 上
# make build 产出的 client2api / probe 没有后缀，不点名就会一直躺在仓库根。
bin/

# IDE
.idea/
.vscode/
.cursor/

# Windows 安装器的构建产物。payload/ 是 build.ps1 把二进制和（可能的）
# 账号数据暂存进去的地方，.gitkeep 是 //go:embed 在空仓里能编译的唯一保障；
# rsrc.rc / *.syso 由 windres 生成，dist/ 装最终的 setup.exe。
/installer/setup/payload/*
!/installer/setup/payload/.gitkeep
/installer/setup/rsrc_windows_amd64.syso
/installer/rsrc.rc
/dist/
# Local agent state and Windows smoke-test leftovers.
.omo/
# CodeGraph's tree-sitter index is a ~40MB generated cache; rebuild it
# locally with `codegraph init -i`, never commit it.
.codegraph/
/$null
client2api.pid
*.log.prev
*.prev.log

# Linux/macOS release binaries.
/probe

# Local browser snapshots, screenshots, launcher wrappers and shell fragments.
.playwright-cli/
/output/playwright/*.png
/output/playwright/pw.cmd
/output/playwright/[{]*
/setTimeout(r
/v.includes(x))+1))
/[{]const
/[{]window.location.hash

# 面板 smoke 测试的临时工作目录：里面会落一份活的 config + data/ 拷贝，禁止入库。
/output/tmp-c2a/

# 一次性排查留下的 shell 重定向碎片和探针工作目录。这些文件名本身就是命令片段
# （`0){n++`、`console.log(JSON.stringify({ip` 这类），git status 里会和真实改动混在
# 一起，`git add -A` 会把它们连同账号探针输出一起提交。根目录下的 `[!({0-9]` 开头
# 只可能是这类碎片：仓库里没有任何合法文件长这样。
#
# /cmd/*-temp/ 只放临时 scratch，不进版本库。要长期留用的探针别放这里：它属于
# 模块默认构建面，会跟着 `go vet/build/test ./...` 一起编译。放到 tools/<name>/
# 并加 `//go:build ignore`（见 tools/README.md）；installer/probe_surface_test.go
# 的守卫会在 cmd/*-temp 里出现可编译的 .go 文件时失败。
/.tmp-*
/.codex_tmp/
/tmp_*.go
/tmp_*.json
/cmd/*-temp/
/output/playwright/*.js
/[0-9]*
/[{]*
/[(]*
/[!]*
/console.log(*
/db.prepare(s).all(...p)
/globalThis.fetch'
/attempts'
/s.destroy()
/s.src)})`
/strftime
/JSON.stringify({w
/x.type
/!loop.has(x.name)
/output/*.jsonl
/output/playwright/*.txt

# oil-ui 设计会话的工作产物（截图/探针/临时脚本），只有 .gitignore 自身，不入库。
.oil-ui/

# 本地协作代理的工作目录：里面是任务笔记、进度日志一类的本机状态，不是项目产物。
# 和 .omo/ / .codegraph/ / .oil-ui/ 同一类。agent 会顺手往里写 markdown，而仓库是
# public 的，漏挡一次就可能把本地笔记连同别的痕迹一起推上去。
.workbuddy/
.zcode/
